{
    "folders": [
        {
            "name": "silkscreen",
            "path": "."
        },
        {
            "name": "firmware",
            "path": "firmware"
        },
        {
            "name": "hardware",
            "path": "hardware"
        }
    ],
    "settings": {
        "platformio-ide.activateProjectOnTextEditorChange": true,
        "files.exclude": {
            "firmware": true,
            "hardware": true
        }
    },
    "extensions": {
        "recommendations": [
            "platformio.platformio-ide"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Run backend server",
                "type": "shell",
                "command": "${workspaceFolder:silkscreen}/run-server.sh",
                "problemMatcher": [],
                "presentation": {
                    "panel": "dedicated",
                    "clear": true,
                    "focus": false
                }
            },
            {
                "label": "Build release firmware",
                "type": "shell",
                "command": "python3 ${workspaceFolder:silkscreen}/app/tools/bundle_firmware.py ${input:releaseBoards}",
                "problemMatcher": [],
                "presentation": {
                    "panel": "dedicated",
                    "clear": true,
                    "focus": true
                }
            }
        ],
        "inputs": [
            {
                "id": "releaseBoards",
                "type": "promptString",
                "description": "PlatformIO env(s) to build and ship, space-separated",
                "default": "blackpill_f411ce"
            }
        ]
    }
}
