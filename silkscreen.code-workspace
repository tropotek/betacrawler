{
    "folders": [
        {
            "name": "silkscreen",
            "path": "."
        },
        {
            "name": "firmware",
            "path": "firmware"
        }
    ],
    "settings": {
        "platformio-ide.activateProjectOnTextEditorChange": true,
        "files.exclude": {
            "firmware": true
        }
    },
    "extensions": {
        "recommendations": [
            "platformio.platformio-ide"
        ]
    },
    "tasks": {
        "version": "2.0.0",
        "tasks": [
            {
                "label": "Run backend server",
                "type": "shell",
                "command": "${workspaceFolder:silkscreen}/run-server.sh",
                "problemMatcher": [],
                "presentation": {
                    "panel": "dedicated",
                    "clear": true,
                    "focus": false
                }
            }
        ]
    }
}
