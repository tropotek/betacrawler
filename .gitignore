# nested .git. Can appear under any folder that gets edited, not just one.
.history/

# superpowers subagent-driven-development scratch (ledgers, briefs, reports)
.superpowers/

# local working notes, not shared via the repo
_notes/

# Claude Code: local-only, not shared via the repo. .claude/skills/ (project
# skills) is intentionally NOT ignored -- those are checked in.
.claude/worktrees/
.claude/settings.local.json
