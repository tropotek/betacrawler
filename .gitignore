# PlatformIO
.pio/
.pioenvs/
.piolibdeps/
.idea/

# Firmware the desktop app ships with: build output, not source. Produced by
# `python3 app/tools/bundle_firmware.py <board>` at release time, and by
# nothing else. The manifest is ignored along with the binaries on purpose --
# committing one without the others gives you a manifest whose sha256 fields
# describe files that aren't there, which is the exact drift that script
# exists to prevent.
#
# The same run also writes web-app/firmware/, which IS committed: the static
# site has no backend to build an image on demand, so what it flashes travels
# with it. web-app/tests/firmware-bundle.test.js fails if those binaries drift
# from the firmware sources.
app/firmware/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# MkDocs docs site: local tool venv and build output, not source.
docs/.venv/
site/

# KiCad (hardware/) local caches & backups -- not project source
*.kicad_prl
*-backups/
_autosave-*
fp-info-cache

# Docker hosting config: per-deployment secrets/ports, not source. .env.example
# documents the variables and is committed.
.env

# Editor / OS
.vscode/
.DS_Store
# VS Code "Local History" extension -- per-file snapshot dir, keeps its own
# nested .git. Can appear under any folder that gets edited, not just one.
.history/

# superpowers subagent-driven-development scratch (ledgers, briefs, reports)
.superpowers/

# local working notes, not shared via the repo
_notes/

# Claude Code: local-only, not shared via the repo. .claude/skills/ (project
# skills) is intentionally NOT ignored -- those are checked in.
.claude/worktrees/
.claude/settings.local.json
