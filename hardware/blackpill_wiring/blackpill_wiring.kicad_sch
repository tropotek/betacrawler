	)
	(text "Never 3V3. Add a 470-1000 uF bulk cap at the connector -- a moving servo can droop VBUS enough to reset the MCU."
		(exclude_from_sim no)
		(at 40 165 0)
		(effects
			(font
				(size 1.27 1.27)
			)
